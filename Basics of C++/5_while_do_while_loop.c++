#include <iostream>

using namespace std;

int main(){
        // while loop: 
   int index= 1;
   while (index<11)
   {
     cout<<"The index value is: "<<index<<endl;
     index++;
   }

   int i= 1;

//    do while loop:
   do
   {
        cout<<"\nThe index value is: "<<i<<endl;
        i++;
   } while (i>2340);
}