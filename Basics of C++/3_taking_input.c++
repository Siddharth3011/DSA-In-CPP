#include<iostream>

using namespace std;

int main(){
        // for taking input:
        int x;
        cout<<"Enter the first number: ";
        cin>>x; 
        int y;
        cout<<"Enter the secound number: ";
        cin>>y;
        
        // Arithmetic operations:
        cout<<"The sum is: "<<x+y<<endl;
        cout<<"The sub is: "<<x-y<<endl;
        cout<<"The mult is: "<<x*y<<endl;
        cout<<"The div is: "<<x/y<<endl;
}